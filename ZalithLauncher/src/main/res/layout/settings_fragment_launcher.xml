<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:scrollbars="none"
    tools:ignore="UseSwitchCompatOrMaterialXml">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_10sdp">

        <!-- HEADER BLOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_4sdp">
            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/ic_setting_launcher"
                app:tint="#9D4EDD" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="LAUNCHER SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/download_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <!-- Check Libraries Toggle -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/checkLibraries_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/checkLibraries_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/checkLibraries"
                    android:text="@string/setting_check_libraries_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/checkLibraries_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/checkLibraries_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/checkLibraries"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_check_libraries_desc" />
                <Switch
                    android:id="@+id/checkLibraries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true"/>
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Verify Manifest Toggle -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/verifyManifest_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/verifyManifest_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/verifyManifest"
                    android:text="@string/setting_verify_manifest_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/verifyManifest_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/verifyManifest_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/verifyManifest"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_verify_manifest_desc" />
                <Switch
                    android:id="@+id/verifyManifest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Cache Toggle -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/resourceImageCache_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/resourceImageCache_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/resourceImageCache"
                    android:text="@string/setting_resource_image_cache_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/resourceImageCache_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/resourceImageCache_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/resourceImageCache"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_resource_image_cache_desc" />
                <Switch
                    android:id="@+id/resourceImageCache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Resource Full Name Toggle -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/addFullResourceName_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/addFullResourceName_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/addFullResourceName"
                    android:text="@string/setting_resource_full_name_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/addFullResourceName_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/addFullResourceName_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/addFullResourceName"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_resource_full_name_desc" />
                <Switch
                    android:id="@+id/addFullResourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Download Source -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/downloadSource_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/downloadSource_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/setting_download_source_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/downloadSource_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/downloadSource_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:text="@string/setting_download_source_desc" />
                <TextView
                    android:id="@+id/downloadSource_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/downloadSource_summary"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#9D4EDD"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/generic_default" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Download Threads Slider -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/maxDownloadThreads_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:paddingBottom="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/maxDownloadThreads_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/setting_max_download_threads_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/maxDownloadThreads_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/maxDownloadThreads_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:text="@string/setting_max_download_threads_desc" />
                <SeekBar
                    android:id="@+id/maxDownloadThreads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/maxDownloadThreads_value"
                    android:layout_alignBottom="@+id/maxDownloadThreads_value"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/maxDownloadThreads_value"
                    android:max="128"
                    android:min="1" />
                <TextView
                    android:id="@+id/maxDownloadThreads_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/maxDownloadThreads_summary"
                    android:layout_alignParentEnd="true"
                    android:layout_marginVertical="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:textColor="#9D4EDD"
                    android:textStyle="bold"
                    android:textSize="@dimen/_9ssp"
                    tools:text="64 threads" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/personalization_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <!-- Launcher Custom Themes -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/launcherTheme_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/launcherTheme_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/setting_launcher_theme"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/launcherTheme_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/launcherTheme_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/generic_default" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Custom Background Wallpaper Profile -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/custom_background_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/custom_background_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/custom_background_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/custom_background_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/custom_background_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/custom_background_desc" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Animation Toggle Switch -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/animation_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/animation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/animation"
                    android:text="@string/setting_animation_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/animation_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/animation_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/animation"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_animation_desc" />
                <Switch
                    android:id="@+id/animation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Animation Speeds Slider -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/animationSpeed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:paddingBottom="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/animationSpeed_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/setting_animation_speed_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/animationSpeed_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/animationSpeed_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:text="@string/setting_animation_speed_desc" />
                <SeekBar
                    android:id="@+id/animationSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/animationSpeed_value"
                    android:layout_alignBottom="@+id/animationSpeed_value"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/animationSpeed_value"
                    android:max="1500"
                    android:min="300" />
                <TextView
                    android:id="@+id/animationSpeed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/animationSpeed_summary"
                    android:layout_alignParentEnd="true"
                    android:layout_marginVertical="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:textColor="#9D4EDD"
                    android:textStyle="bold"
                    android:textSize="@dimen/_9ssp"
                    tools:text="400 ms" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Page Back Opacity Density Selector Slider -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/pageOpacity_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:paddingBottom="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/pageOpacity_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/setting_page_opacity_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/pageOpacity_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/pageOpacity_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:text="@string/setting_page_opacity_desc" />
                <SeekBar
                    android:id="@+id/pageOpacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/pageOpacity_value"
                    android:layout_alignBottom="@+id/pageOpacity_value"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/pageOpacity_value"
                    android:max="100"
                    android:min="50" />
                <TextView
                    android:id="@+id/pageOpacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/pageOpacity_summary"
                    android:layout_alignParentEnd="true"
                    android:layout_marginVertical="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:textColor="#9D4EDD"
                    android:textStyle="bold"
                    android:textSize="@dimen/_9ssp"
                    tools:text="85%" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/launcher_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical">

            <!-- Log Outputs Engine -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/enableLogOutput_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/enableLogOutput_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/enableLogOutput"
                    android:text="@string/setting_enable_log_output_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/enableLogOutput_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/enableLogOutput_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/enableLogOutput"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_enable_log_output_desc" />
                <Switch
                    android:id="@+id/enableLogOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Quit Launcher Action -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/quitLauncher_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/quitLauncher_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/quitLauncher"
                    android:text="@string/setting_quit_launcher_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/quitLauncher_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/quitLauncher_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/quitLauncher"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_quit_launcher_desc" />
                <Switch
                    android:id="@+id/quitLauncher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Cache System Cleanups Trigger Actions -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/clean_up_cache_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/clean_up_cache_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/clear_up_cache"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/clean_up_cache_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/clean_up_cache_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/clear_up_cache_desc" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Update Checks -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/check_update_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/check_update_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:text="@string/update"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/check_update_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/check_update_title"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/update_summary" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Pre-Release Beta Updates Toggles -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/acceptPreReleaseUpdates_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp">
                <TextView
                    android:id="@+id/acceptPreReleaseUpdates_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/acceptPreReleaseUpdates"
                    android:text="@string/setting_accept_pre_release_updates_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/acceptPreReleaseUpdates_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/acceptPreReleaseUpdates_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/acceptPreReleaseUpdates"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_accept_pre_release_updates_desc" />
                <Switch
                    android:id="@+id/acceptPreReleaseUpdates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <!-- Notifications Requests Setup -->
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/notification_permission_request_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:padding="@dimen/_12sdp">
                <TextView
                    android:id="@+id/notification_permission_request_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/notification_permission_request"
                    android:text="@string/setting_ask_for_notification_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="@dimen/_11ssp" />
                <TextView
                    android:id="@+id/notification_permission_request_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/notification_permission_request_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_toStartOf="@+id/notification_permission_request"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_9ssp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/setting_ask_for_notification_desc" />
                <Switch
                    android:id="@+id/notification_permission_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
