<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="@dimen/_10sdp">

    <!-- HEADER TITLE & BRANDING LAYER -->
    <LinearLayout
        android:id="@+id/capes_skins_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_4sdp"
        app:layout_constraintTop_toTopOf="parent">
        
        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_setting_launcher"
            app:tint="#9D4EDD" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="SKIN &amp; CAPE CUSTOMIZATION"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- 1️⃣ LEFT SIDE MODULE PANEL: 3D LIVE PREVIEW WORKSPACE -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_card_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@drawable/card_glass_bg"
        android:padding="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/capes_skins_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_inputs_card">

        <!-- Glowing Neon Live Indicator Badge -->
        <TextView
            android:id="@+id/live_preview_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#339D4EDD"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:text="● LIVE PREVIEW"
            android:textColor="#9D4EDD"
            android:textStyle="bold"
            android:textSize="@dimen/_8ssp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Skin Render Display Surface View (Binds to Minecraft Entity Renderer) -->
        <SurfaceView
            android:id="@+id/skin_render_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintTop_toBottomOf="@id/live_preview_badge"
            app:layout_constraintBottom_toBottomOf="parent" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2️⃣ RIGHT SIDE MODULE PANEL: RECTANGLE CONTROL STRINGS & PICKERS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/control_inputs_card"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/card_glass_bg"
        android:padding="@dimen/_14sdp"
        app:layout_constraintTop_toBottomOf="@id/capes_skins_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            android:layout_marginBottom="@dimen/_10sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/actions_flow_block">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL ASSETS SELECTION"
                    android:textColor="#7D7495"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_10sdp" />

                <!-- SKIN PATH FIELD BLOCK -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minecraft Character Skin (.png)"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_10ssp"
                    android:layout_marginBottom="@dimen/_4sdp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="#26120C1F"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_14sdp">

                    <EditText
                        android:id="@+id/skin_path_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/btn_pick_skin"
                        android:background="@android:color/transparent"
                        android:hint="No custom skin selected"
                        android:textColorHint="#4DFFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_10ssp"
                        android:focusable="false"
                        android:clickable="false" />

                    <ImageButton
                        android:id="@+id/btn_pick_skin"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_folder"
                        app:tint="#9D4EDD" />
                </RelativeLayout>

                <!-- CAPE PATH FIELD BLOCK -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OptiFine / Custom Cape Texture"
                    android:textColor="#A09BB0"
                    android:textSize="@dimen/_10ssp"
                    android:layout_marginBottom="@dimen/_4sdp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_36sdp"
                    android:background="#26120C1F"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp">

                    <EditText
                        android:id="@+id/cape_path_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/btn_pick_cape"
                        android:background="@android:color/transparent"
                        android:hint="Default cape active"
                        android:textColorHint="#4DFFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_10ssp"
                        android:focusable="false"
                        android:clickable="false" />

                    <ImageButton
                        android:id="@+id/btn_pick_cape"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_folder"
                        app:tint="#9D4EDD" />
                </RelativeLayout>
            </LinearLayout>
        </ScrollView>

        <!-- BOTTOM SAVE / CANCEL EXECUTION TRIGGER FLOW -->
        <LinearLayout
            android:id="@+id/actions_flow_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btn_cancel_skin_flow"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_4dp"
                android:text="Cancel"
                android:textColor="#A09BB0"
                android:background="?android:attr/selectableItemBackground" />

            <com.movtery.zalithlauncher.ui.view.AnimButton
                android:id="@+id/btn_save_skin_flow"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="Apply Changes"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/button_background" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
