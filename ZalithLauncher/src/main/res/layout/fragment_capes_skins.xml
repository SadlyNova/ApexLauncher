<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="@dimen/_10sdp"
    android:clickable="true"
    android:focusable="true">

    <!-- HEADER TITLE TRACK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginStart="@dimen/_4sdp">
        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_setting_launcher"
            app:tint="#9D4EDD" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="CAPES &amp; SKINS CUSTOMIZATION"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="10">

        <!-- LEFT VIEWPORT CARD: PREVIEW PRE-RENDERING PLACEHOLDER -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:layout_marginEnd="@dimen/_6sdp"
            android:background="@drawable/card_glass_bg"
            android:padding="@dimen/_8sdp">

            <TextView
                android:id="@+id/live_preview_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#339D4EDD"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:text="● LIVE STATUS"
                android:textColor="#9D4EDD"
                android:textStyle="bold"
                android:textSize="@dimen/_8ssp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 👑 STABLE VIEWPORT FRAME: Replaced complex surface blocks with layout matrix to secure active rendering states -->
            <View
                android:id="@+id/skin_render_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="#26FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/live_preview_badge"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- RIGHT CONFIGURATION PANEL CARD -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/card_glass_bg"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL TEXTURE FILES"
                        android:textColor="#7D7495"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/_8sdp" />

                    <!-- CHARACTER SKIN INPUT CONTROLLER -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Character Skin File (.png)"
                        android:textColor="#A09BB0"
                        android:textSize="@dimen/_10ssp"
                        android:layout_marginBottom="@dimen/_3sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_32sdp"
                        android:background="#26120C1F"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_10sdp">
                        <EditText
                            android:id="@+id/skin_path_input"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/btn_pick_skin"
                            android:background="@android:color/transparent"
                            android:hint="No custom skin active"
                            android:textColorHint="#4DFFFFFF"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_9ssp"
                            android:focusable="false"
                            android:clickable="false" />
                        <ImageButton
                            android:id="@+id/btn_pick_skin"
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_folder"
                            app:tint="#9D4EDD"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>

                    <!-- CUSTOM CAPE INPUT CONTROLLER -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom Cape File (.png)"
                        android:textColor="#A09BB0"
                        android:textSize="@dimen/_10ssp"
                        android:layout_marginBottom="@dimen/_3sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_32sdp"
                        android:background="#26120C1F"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_12sdp">
                        <EditText
                            android:id="@+id/cape_path_input"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/btn_pick_cape"
                            android:background="@android:color/transparent"
                            android:hint="Default cape active"
                            android:textColorHint="#4DFFFFFF"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_9ssp"
                            android:focusable="false"
                            android:clickable="false" />
                        <ImageButton
                            android:id="@+id/btn_pick_cape"
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_folder"
                            app:tint="#9D4EDD"
                            android:clickable="true"
                            android:focusable="true" />
                    </RelativeLayout>
                </LinearLayout>
            </ScrollView>

            <!-- FOOTER CONTAINER EXECUTION INTERACTIVE TRIPPERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <Button
                    android:id="@+id/btn_cancel_skin_flow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:text="CANCEL"
                    android:textColor="#A09BB0"
                    android:background="?android:attr/selectableItemBackground" />
                <Button
                    android:id="@+id/btn_save_skin_flow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="SAVE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/button_background" />
            </LinearLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</LinearLayout>
