<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/card_glass_bg"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingVertical="@dimen/_16sdp"
    android:minWidth="@dimen/dialog_min_width">

    <!-- ================================================================= -->
    <!-- LEFT PANEL CONTENT LAYER (INNER FLEX WRAPPER)                    -->
    <!-- ================================================================= -->
    
    <!-- Extraction Header Text Label Indicator -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/update_downloading"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Continuous Small Infinite Spinning Vector -->
    <ProgressBar
        android:id="@+id/progressView"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:indeterminateTint="#9D4EDD"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/textView" />

    <!-- ================================================================= -->
    <!-- DYNAMIC PROGRESS TRACKING SYSTEM MATRIX                            -->
    <!-- ================================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/upload_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="#140D1F"
        android:padding="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView">

        <!-- Speed Vector Counter Output -->
        <TextView
            android:id="@+id/upload_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="#A09BB0"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- High-End Flat Neon Installation Progress Slider Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:progressDrawable="@drawable/button_background"
            android:indeterminateTint="#9D4EDD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/upload_rate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================================================================= -->
    <!-- ACTION TRIGGER CONTROLLERS (AGREE / INSTALL / CANCEL VECTOR)       -->
    <!-- ================================================================= -->
    <com.movtery.zalithlauncher.ui.view.AnimButton
        android:id="@+id/cancel_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:text="Agree and Install  ›"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="@dimen/_11ssp"
        android:background="@drawable/button_background"
        android:elevation="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/upload_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>
