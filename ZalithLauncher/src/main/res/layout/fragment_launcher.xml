<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/launcher_components_recyclerview"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_12sdp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/launcher_side_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_side_card"
        android:layout_width="@dimen/_240sdp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_12sdp"
        android:background="@drawable/card_glass_bg"
        android:padding="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/launcher_instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The launcher needs to install these contents to ensure Minecraft can start properly. These contents are included in the app and need to be extracted before they can be used."
            android:textColor="#A09BB0"
            android:textSize="@dimen/_10ssp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/launcher_portal_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="@dimen/_14sdp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu_custom_controls"
            app:tint="#269D4EDD"
            app:layout_constraintBottom_toTopOf="@+id/launcher_install_action_btn"
            app:layout_constraintTop_toBottomOf="@+id/launcher_instruction_text" />

        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/launcher_install_action_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:text="Agree and Install"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="@dimen/_11ssp"
            android:background="@drawable/button_background"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
